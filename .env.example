PORT=5000
NODE_ENV=development

JWT_SECRET=replace_with_super_long_random_key
JWT_EXPIRY=7d

DB_PATH=./db.json

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="MtaaniHost <no-reply@mtaanitech.com>"

PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
BASE_DOMAIN=mtaanitech.workers.dev

APP_URL=http://localhost:5000

ADMIN_PASSWORD=your_strong_admin_password
ADMIN_PASSWORD_HASH=$2b$10$generated_hash_here

MAX_LOGIN_ATTEMPTS=5
LOCK_TIMEOUT_MS=900000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_FILE_SIZE=52428800
